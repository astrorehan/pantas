# Salin ke .env.local lalu isi. Semua variabel opsional — tanpa nilai,
# aplikasi jalan penuh dalam mode demo offline (localStorage + data seed).

# Supabase (Fase 1): URL proyek + publishable/anon key (aman di browser, RLS aktif).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI pembungkus PantasModel (Fase 2), mis. Hugging Face Spaces.
NEXT_PUBLIC_PREDICT_URL=

# --- Server-only. Tanpa prefix NEXT_PUBLIC_, jadi tidak pernah masuk bundle
# --- browser (NFR-SEC-02). Hanya dibaca route handler di src/app/api/.

# Service role key Supabase. Melewati RLS — dipakai hanya oleh /api/demo/reset
# dan /api/cron/*. Jangan pernah menaruhnya di variabel NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Token bersama untuk POST /api/demo/reset. Nilai yang sama harus dipasang
# sebagai secret repositori `DEMO_RESET_TOKEN`, karena penjadwalannya ada di
# .github/workflows/reset-demo.yml (paket Vercel Hobby membatasi cron ke sekali
# sehari). Tanpa nilai, endpoint selalu membalas 401.
DEMO_RESET_TOKEN=

# Token Vercel Cron untuk GET /api/cron/harga. Tanpa header
# `Authorization: Bearer <nilai>` permintaan dibalas 401. Bila secret belum
# dikonfigurasi, route gagal tertutup dengan 503 di semua environment.
CRON_SECRET=

# Sumber harga acuan harian. Diharapkan membalas JSON `[{komoditas, harga}]`
# atau `{data: [...]}` dengan `komoditas` memakai kunci yang sama dengan tabel
# `harga_acuan` (mis. `chili_rawit`). Terisi -> baris ditulis dengan sumber
# "PIHPS DIY". Kosong atau gagal diambil -> cron memakai angka simulasi bawaan
# dan menuliskannya sebagai "Simulasi feed PIHPS DIY", supaya bedanya kelihatan
# di layar harga petani, bukan disembunyikan.
PIHPS_FEED_URL=
