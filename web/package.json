  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "16.3.4",
    "next-intl": "^4.13.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
